{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"module": "es2022",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": ["ES2022"],
		"types": [],
		"rewriteRelativeImportExtensions": true,
		"rootDir": "../src",
		"outDir": "../out/web"
	},
	// the source files of src/ that the web pages' hosts share with the extension, built again as ES modules (src/ itself is CommonJS)
	"include": ["../src/fontmodel.ts", "../src/glyphatlas.ts"],
	"references": [{ "path": "../webview" }]
}
