// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Development Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"outFiles": [
				"${workspaceFolder}/out/src/**/*.js",
				"${workspaceFolder}/node_modules/@isopodlabs/*/dist/**/*.js"
			],
			"sourceMaps": true,
			"preLaunchTask": "npm: watch-link",
			"windows": {
				"args": [
					"--extensionDevelopmentPath=${workspaceFolder}",
					"--new-window",
					"D:\\dev\\packages\\debug.code-workspace"
					//"D:\\dev\\shared\\"
					//"D:\\dev\\vscode_ext\\registry"
					//"D:\\dev\\vscode_ext\\vstools"
				],
			},
			"osx": {
				"args": [
					"--extensionDevelopmentPath=${workspaceFolder}",
					//"--remote=ssh-remote+ubuntu-adrian",
					//"/mnt/e/Github/xdg-desktop-portal/xdg-desktop-portal-gnome"
					//"/Volumes/DevSSD/dev/SkyNetLights/firmware"
					//"/Volumes/DevSSD/dev/shared"
				],
			},
			"linux": {
				"args": [
					"--extensionDevelopmentPath=${workspaceFolder}",
					"--remote=ssh-remote+ubuntu-adrian",
					"/mnt/e/Github/xdg-desktop-portal/xdg-desktop-portal-gnome"
					//"/mnt/d/dev/shared"
				],
			},
			"env": {
				"NODE_PRESERVE_SYMLINKS": "1"
			},
			//"resolveSourceMapLocations": [],
			//	"${workspaceFolder}/**",
			//	"${workspaceFolder}/node_modules/@isopodlabs/**",
			//	//"!**/node_modules/**"
			//]
		},
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			// only the extension host's own output: the webview bundles under out/webview are emitted with inline source
			// maps and inline sources, and vscode-js-debug parses every map in outFiles before it lets the host start,
			// which leaves it paused past the readiness timeout (see vscode-js-debug#2265)
			"outFiles": [
				"${workspaceFolder}/out/src/**/*.js",
			],
			"sourceMaps": true,
			"preLaunchTask": "npm: watch",
			"windows": {
				"args": [
					"--extensionDevelopmentPath=${workspaceFolder}",
					"D:\\dev\\packages\\debug.code-workspace"
				],
			},
			"osx": {
				"args": [
					"--inspect=127.0.0.1:9229",
					"--extensionDevelopmentPath=${workspaceFolder}",
					"/Volumes/DevSSD/dev/shared"
				],
				"autoAttachChildProcesses": false
			},
			"timeout": 30000
		},
		{
			// workaround for js-debug connecting to ::1 while the extension host inspector listens on 127.0.0.1 only:
			// the task opens the dev window paused (--inspect-brk-extensions), and we attach to it by IPv4 address
			"name": "Run Extension (attach)",
			"type": "node",
			"request": "attach",
			"address": "127.0.0.1",
			"port": 9230,
			"timeout": 30000,
			"continueOnAttach": true,
			"sourceMaps": true,
			"preLaunchTask": "Open Extension Dev Window",
			"skipFiles": [
				"<node_internals>/**",
				"**/bootstrap-fork.js"
			],
			"outFiles": [
				"${workspaceFolder}/out/src/**/*.js",
				"${workspaceFolder}/node_modules/@isopodlabs/*/dist/**/*.js"
			],
			"resolveSourceMapLocations": [
				"${workspaceFolder}/**",
				"${workspaceFolder}/node_modules/@isopodlabs/**",
				"/Volumes/DevSSD/dev/packages/**"
			],
		},
		{
			"name": "Attach to Extension Host",
			"type": "node",
			"request": "attach",
			"address": "127.0.0.1",
			"processId": "${command:PickProcess}",
			"skipFiles": [
				"<node_internals>/**",
				"**/bootstrap-fork.js"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js",
				"${workspaceFolder}/node_modules/@isopodlabs/*/dist/**/*.js"
			],
			"resolveSourceMapLocations": [
				"${workspaceFolder}/**",
				"${workspaceFolder}/node_modules/@isopodlabs/**",
				"/Volumes/DevSSD/dev/packages/**"
			],
		}
	]
}
