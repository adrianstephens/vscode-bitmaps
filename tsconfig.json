{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "outDir": "out",
    "sourceMap": true,
    "skipLibCheck": true,
    "strict": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "@isopodlabs/vscode_utils",
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/*.ts", "src/*.tsx"],
  "exclude": ["node_modules", "hidden"],
  "references": [{ "path": "./webview" }]
}
